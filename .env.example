# Copy to .env and fill in. Get a key at https://app.mem0.ai/
# Without it the dashboard uses a local JSON fallback.
MEM0_API_KEY=your-mem0-api-key
# AI writer for the campaign strategist. Use ONE of these; without either an offline strategist is used.
# Claude directly:
ANTHROPIC_API_KEY=
# Or OpenRouter (defaults to a free, zero-cost model; works even with a $0 key limit):
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # or anthropic/claude-opus-5.5 with credit
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
